# Required: subscription link for vpndogs-sb-client-1
# The clients run Xray-core (GFW-knocker fork), so this is the ?app=xray
# subscription: a JSON ARRAY of complete Xray configs, one per "remarks"
# label. Shape: https://<panel-host>/<token>/sub/fragment?app=xray#<name>
# Quote the value: the URL ends in "#<name>" and an unquoted value with a
# space before the # would be truncated by the .env parser.
SUB_URL_1=
# Optional: only used when the matching profile is enabled via COMPOSE_PROFILES
SUB_URL_2=
SUB_URL_3=
SUB_URL_4=
# Optional: which profile to run, matched against the sub's "remarks" labels
# (default: "💦 🔗 Smart Fragment 🧠" — chained, TLS-hello fragmentation)
FINAL_TAG="💦 🔗 Smart Fragment 🧠"
# Optional: outbound handshake budget in seconds. The panel ships 4, but a
# fragmented two-hop handshake costs 1-4.6s.
HANDSHAKE_TIMEOUT=15
# Optional: observatory probe URL. MUST be an IP literal: a hostname would
# have to be resolved through the tunnel, which needs the observatory.
PROBE_URL=https://8.8.8.8/dns-query
# Comma-separated: which extra clients to run, e.g. sb-client-2,sb-client-4
COMPOSE_PROFILES=
# SoftEther fallback: profile name (without .vpn) from vpn-profiles/, or SE_* vars
VPN_PROFILE=
SE_HOST=
SE_PORT=443
SE_HUB=
SE_USER=
SE_PASSWORD=
# Optional inbound IPsec node: enable with COMPOSE_PROFILES=ipsec-inbound.
# All three are required by the image; without them it exits and restart-loops.
# IPSEC_USERS entries split on the FIRST colon, so passwords may contain colons.
# Usernames are letters/digits/_@+- only; no # { } " ' or line breaks anywhere.
IPSEC_USERS=
IPSEC_PSK=
# Public IP or DNS name clients dial — it becomes the server certificate's CN and
# SAN, and native IKEv2 clients refuse a server whose SAN does not match.
# An IP literal gets both an iPAddress and a dNSName SAN (Windows requires the
# latter). Changing this on an existing volume keeps the OLD certificate: delete
# the ipsec-certs volume to regenerate, then clients re-import the CA.
VPN_SERVER_ADDR=
# Must not overlap the container's own subnet or your LAN; the image refuses to
# boot if it does.
VPN_POOL=10.10.10.0/24
CLIENT_DNS=1.1.1.1
# Optional inbound WireGuard node: enable with COMPOSE_PROFILES=wg-inbound.
# Required by the image; without it the container exits and restart-loops.
# Entries are name:PUBKEY, comma-separated, split on the FIRST colon. Keys are
# BYO: generate on the client (wg genkey | wg pubkey) and pass only the PUBLIC
# key — private keys never touch the server. Names: letters/digits/_@+- only.
WG_PEERS=
# Server takes the pool's first address; peer i (0-based, WG_PEERS order) gets
# network+2+i. Must not overlap the container's own subnet or your LAN.
WG_POOL=10.10.20.0/24
# Optional inbound AmneziaWG node: enable with COMPOSE_PROFILES=awg-inbound.
# Required by the image; without it the container exits and restart-loops.
# Entries are name:PUBKEY, comma-separated, split on the FIRST colon. Keys are
# BYO: generate on the client (awg genkey | awg pubkey) and pass only the
# PUBLIC key — private keys never touch the server. Names: letters/digits/_@+-
# only. AmneziaWG 3.1 clients only (AWG 1.x unsupported).
AWG_PEERS=
# Server takes the pool's first address; peer i (0-based, AWG_PEERS order) gets
# network+2+i. Must not overlap the container's own subnet or your LAN. Third
# pool: ipsec uses 10.10.10.0/24, wg uses 10.10.20.0/24, openvpn uses
# 10.10.40.0/24.
AWG_POOL=10.10.30.0/24
# HeaderProtectionKey — shared secret (awg genkey), THE SAME value in every
# client conf. Empty = header protection off.
AWG_HPK=
# Optional inbound OpenVPN node: enable with COMPOSE_PROFILES=ovpn-inbound.
# The two REQUIRED vars have no defaults on purpose: the entrypoint exits and
# restart-loops until they are set.
# Entries are user:pass, comma-separated, split on the FIRST colon, so passwords
# may contain colons — but not a comma or newline, which the format cannot
# express. Usernames are letters/digits/_@+- only.
OVPN_USERS=
# VPN_SERVER_ADDR is NOT redeclared here: the one above (in the IPsec block) is
# shared by every inbound node — one host address for the whole stack. Do not add
# a second `VPN_SERVER_ADDR=` line: dotenv keeps the LAST assignment, so a blank
# one here would blank the value the ipsec node already uses.
# The OpenVPN node additionally turns it into the server certificate's CN and SAN,
# and clients verify it (remote-cert-tls server).
# Server pool; clients draw addresses from it in connection order (unlike the wg
# and awg nodes there is no deterministic per-peer mapping). Must not overlap the
# container's own subnet or your LAN. Fourth pool: ipsec 10.10.10.0/24, wg
# 10.10.20.0/24, awg 10.10.30.0/24.
OVPN_POOL=10.10.40.0/24
# Optional inbound TLS (Trojan) node: enable with COMPOSE_PROFILES=tls-inbound.
# The two REQUIRED vars have no defaults on purpose: the entrypoint exits and
# restart-loops until they are set.
# Domain pointing to this server for automated Let's Encrypt certificates and Trojan SNI.
# Strips leading www. automatically; certs are requested for <domain>.
TLS_DOMAIN=
# Entries are user:pass, comma-separated, split on the FIRST colon.
TLS_USERS=
# Optional email for Let's Encrypt expiration notifications.
TLS_EMAIL=

